{
  "version": 2,
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/build",
  "installCommand": "cd frontend && npm install",
  
  "functions": {
    "api/index.py": {
      "runtime": "python3.12"
    }
  },
  
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ],
  
  "env": {
    "ENVIRONMENT": "production",
    "GEMINI_API_KEY": "@gemini_api_key"
  }
}
