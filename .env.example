# Deterministic local analysis is the default zero-key review path.

APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173
MAX_RESUME_FILE_MB=5
MAX_RESUME_CHARS=20000
MAX_JD_CHARS=20000
ENABLE_AI_ANALYSIS_CACHE=true
AI_ANALYSIS_CACHE_TTL_SECONDS=86400

# Optional external GenAI. This is server-side and opt-in.
# Enabling it sends extracted resume text and the submitted job description
# to the configured endpoint. Do not enable it for sensitive documents unless
# that data flow has been explicitly approved.
ENABLE_EXTERNAL_GENAI=false
EXTERNAL_GENAI_URL=
EXTERNAL_GENAI_API_KEY=
EXTERNAL_GENAI_MODEL=general
EXTERNAL_GENAI_TIMEOUT_SECONDS=30
